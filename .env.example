# Copy this file to `.env` and fill in your own values.
# NEVER commit your real `.env` file.

# Your OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your-api-key-here

# A model your API account can use. Run `python scripts/list_models.py`
# to see the model IDs available to your key, then paste one here.
OPENAI_MODEL=your-model-name-here

# Optional settings (defaults shown)
# SYSTEM_PROMPT=You are Smart AI, a helpful, friendly and accurate assistant.
# MAX_MESSAGE_CHARS=4000
# MAX_HISTORY_MESSAGES=20
# MAX_OUTPUT_TOKENS=1500
# RATE_LIMIT_PER_MINUTE=20
# OPENAI_TIMEOUT_SECONDS=60

# Leave empty to auto-generate a key stored in instance/.secret_key
SECRET_KEY=

# Development only. Keep false anywhere other than your own machine.
FLASK_DEBUG=false
